#!/usr/bin/env bash
# Fetch the Kokoro-82M ONNX model, its tokenizer and the English voice packs
# into ${XDG_CACHE_HOME:-~/.cache}/cosmo/models/kokoro-v1.0/ (spec §2.5).
#
#   scripts/fetch-models              # the default variant (fp32) + all English voices
#   scripts/fetch-models --variant q8 # the int8-quantized model instead
#   scripts/fetch-models --all-variants
#   scripts/fetch-models --vad        # the Silero VAD model only (phase-3 §3.3)
#
# Every file is pinned to one repository revision and checked against a
# SHA-256 before it is moved into place: a truncated or tampered download
# never becomes a file the daemon loads. Re-running is cheap — files that
# already verify are skipped. This is the groundwork for phase 8's first-run
# fetch UX, not that UX itself.
#
# Source: huggingface.co/onnx-community/Kokoro-82M-v1.0-ONNX (Apache-2.0),
# the ONNX export of hexgrad/Kokoro-82M (Apache-2.0).
set -euo pipefail

# Silero VAD, as sherpa-onnx republishes it (MIT). A release asset, not a
# git revision, so the checksum is what pins it.
VAD_URL="https://github.com/k2-fsa/sherpa-onnx/releases/download/asr-models/silero_vad.onnx"
VAD_SHA="9e2449e1087496d8d4caba907f23e0bd3f78d91fa552479bb9c23ac09cbb1fd6"
VAD_DEST="${XDG_CACHE_HOME:-$HOME/.cache}/cosmo/models/vad"

REPO="onnx-community/Kokoro-82M-v1.0-ONNX"
REV="1939ad2a8e416c0acfeecc08a694d14ef25f2231"
BASE="https://huggingface.co/${REPO}/resolve/${REV}"
DEST="${XDG_CACHE_HOME:-$HOME/.cache}/cosmo/models/kokoro-v1.0"

# variant  file                       sha256
VARIANTS="
    fp32   model.onnx                 8fbea51ea711f2af382e88c833d9e288c6dc82ce5e98421ea61c058ce21a34cb
    fp16   model_fp16.onnx            ba4527a874b42b21e35f468c10d326fdff3c7fc8cac1f85e9eb6c0dfc35c334a
    q8     model_quantized.onnx       fbae9257e1e05ffc727e951ef9b9c98418e6d79f1c9b6b13bd59f5c9028a1478
"
TOKENIZER_SHA="77a02c8e164413299b4b4c403b14f8e0e1c1b727db4d46a09d6327b861060a34"
# English voices only: af_/am_ are en-US, bf_/bm_ en-GB. Each is a raw
# little-endian f32 array, 510 × 256 (one style vector per token count).
VOICES="
    af_alloy     c4a6b876047fd7fb472edf4ebd63cfac7c3b958a7cae7c106e8f038ca6308c45
    af_aoede     4a004c33430762e2461eedb2013fad808ef4ab3121f5300f554476caf58d8361
    af_bella     f69d836209b78eb8c66e75e3cda491e26ea838a3674257e9d4e5703cbaf55c8b
    af_heart     d583ccff3cdca2f7fae535cb998ac07e9fcb90f09737b9a41fa2734ec44a8f0b
    af_jessica   a240a5e3c15b43563d6e923bdca8ef5613a23471d9b77653694012435df23bd8
    af_kore      9be5221b6a941c04b561959b8ff0b06e809444dcc4ab7e75a7b23606f691819e
    af_nicole    cd2191ab31b914ed7b318416b0e4440fdf392ddad9106a060819aa600a64f59a
    af_nova      18778272caa0d0eebaea251c35fd635f038434f9eee5e691d02a174bd328414f
    af_river     00a2bcf82b1d86e8f19902ede58c65ccf6c0e43b44b7d74fad54e5d8933c9c30
    af_sarah     4409fbc125afabacc615d94db5398d847006a737b0247d6892b7a9a0007a2f0a
    af_sky       4435255c9744f3f31659e0d714ab7689bf65d9e77ec1cce060f083912614f0b9
    am_adam      162b035ed91cfc48b6046982184c645f72edcdd1b82843347f605d7bf7b15716
    am_echo      3968b92c3c4cd1c4416dbded36c13eaa388a90d5788d02a13e4d781f5f8cf3c3
    am_eric      e8b5be17edd1e3636901ce7598baafe2dc8dd8ff707a0c23bf9e461add7e2832
    am_fenrir    c27989f741f7ee34d273a39d8a595cc0837d35f5ced9a29b7cc162614616df43
    am_liam      52403be32fd047c6a44517cb0bcd6b134f2a18baa73e70ef41651e0eab921ade
    am_michael   1d1f21dd8da39c30705cd4c75d039d265e9bc4a2a93ed09bc9e1b1225eb95ba1
    am_onyx      da5d135b424164916d75a68ffb4c2abce3d7d5ccc82dd1ee6cf447ce286145e6
    am_puck      fcf73c989033e9233e0b98713eca600c8c74dcc1614b37009d5450ff4a2274a0
    am_santa     61150cf726ab6c5ed7a99f90a304f91f5a72c00c592e89ec94e5df11c319227a
    bf_alice     08afa6ba24da61ea5e8efa139e5aadc938d83f0a6da5a900adaf763ac1da5573
    bf_emma      669fe0647f9dd04fcab92f1439a40eeb4c8b4ab1f82e4996fe3d918ce4a63b73
    bf_isabella  3754352c4aaa46d17f27654ab7518d65b62ad6163a0f55a5f4330c2da2c4e94f
    bf_lily      5e0ee32ebe64a467124976b14e69590746f1c4ce41a12b587a50c862edfea335
    bm_daniel    6b3194bbceffb746733cbc22c8f593dd44e401a71d53895a2dca891bc595a1e8
    bm_fable     f889083196807b4adb15e9204252165f503b8d33d3982e681c52443c49d798f1
    bm_george    c4b235a4c1f2cd3b939fed08b899ce9385638b763f7b73a59616c4fc9bd6c9bc
    bm_lewis     b8f671cef828c30e66fdf0b0756a76bba58f6bb3398cbbf27058642acbcedb97
"

variants=(fp32)
vad=0
while [[ $# -gt 0 ]]; do
    case "$1" in
        --variant) variants=("$2"); shift 2 ;;
        --all-variants) variants=(fp32 fp16 q8); shift ;;
        --vad) vad=1; shift ;;
        -h|--help) sed -n '2,16p' "$0"; exit 0 ;;
        *) echo "unknown argument: $1" >&2; exit 2 ;;
    esac
done

command -v curl >/dev/null || { echo "curl is required" >&2; exit 1; }
command -v sha256sum >/dev/null || { echo "sha256sum is required" >&2; exit 1; }

fetched=0 skipped=0
# fetch <url-path> <dest-path> <sha256>
fetch() {
    local src="$1" out="$2" want="$3"
    if [[ -f "$out" ]] && echo "$want  $out" | sha256sum --check --status; then
        skipped=$((skipped + 1))
        return
    fi
    echo "fetching $src"
    local url="$src"
    [[ "$url" == https://* ]] || url="$BASE/$src"
    curl --fail --location --retry 3 --progress-bar -o "$out.part" "$url"
    if ! echo "$want  $out.part" | sha256sum --check --status; then
        rm -f "$out.part"
        echo "checksum mismatch for $src — refusing to install it" >&2
        exit 1
    fi
    mv "$out.part" "$out"
    fetched=$((fetched + 1))
}

if [[ $vad == 1 ]]; then
    mkdir -p "$VAD_DEST"
    fetch "$VAD_URL" "$VAD_DEST/silero_vad.onnx" "$VAD_SHA"
    echo "silero-vad: $fetched fetched, $skipped already verified → $VAD_DEST"
    exit 0
fi

mkdir -p "$DEST/voices"
for v in "${variants[@]}"; do
    line=$(awk -v v="$v" '$1 == v' <<<"$VARIANTS")
    [[ -n "$line" ]] || { echo "unknown variant: $v (fp32, fp16, q8)" >&2; exit 2; }
    read -r _ file sha <<<"$line"
    fetch "onnx/$file" "$DEST/$file" "$sha"
done
fetch "tokenizer.json" "$DEST/tokenizer.json" "$TOKENIZER_SHA"
while read -r name sha; do
    [[ -n "$name" ]] || continue
    fetch "voices/$name.bin" "$DEST/voices/$name.bin" "$sha"
done <<<"$VOICES"

echo "kokoro-v1.0: $fetched fetched, $skipped already verified → $DEST"
