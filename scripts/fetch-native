#!/usr/bin/env bash
# Build the native libraries the heavy tier links: sherpa-onnx (speech
# recognition) with its static ONNX Runtime, which is also the runtime
# `ort` links for Kokoro. One runtime serves both, because two static ONNX
# Runtimes in one binary do not link (duplicate re2/protobuf symbols;
# phase-3 findings §1).
#
#   scripts/fetch-native            # once; about a minute on 16 threads
#
# Needs cmake, make and a C++ compiler. Installs into .native/ (gitignored).
# `.cargo/config.toml` points SHERPA_ONNX_LIB_DIR and ORT_LIB_PATH there, so
# neither crate's build script downloads anything.
#
# **Built from source with TTS off, on purpose** (phase-3 findings §9).
# sherpa's prebuilt bundle statically links eSpeak NG, which is GPL-3.0, into
# every binary using its C API, including a speech-recognition-only one.
# This build contains none of it: only sherpa-onnx (Apache-2.0), ONNX Runtime
# (MIT), Kaldi / OpenFst / sentencepiece (Apache-2.0), kissfft (BSD-3),
# Eigen (MPL-2.0, headers) and nlohmann/json (MIT). Kokoro's phonemes come
# from the *system* libespeak-ng, loaded at run time, never linked.
#
# The source archive is SHA-256 checked; sherpa's cmake pins each dependency
# it downloads by hash (or, for kissfft, by commit).
set -euo pipefail

VERSION="1.13.8"
SRC_URL="https://github.com/k2-fsa/sherpa-onnx/archive/refs/tags/v${VERSION}.tar.gz"
SRC_SHA256="b0374cc56dbc186d442ae73d5de743bb092470b640c4c50ce7b029044c0c4fa8"
NAME="sherpa-onnx-v${VERSION}-asr-static"
# The prebuilt static ONNX Runtime sherpa links carries no licence files;
# these are upstream's, at the same version, pinned.
ORT_TAG="v1.28.2"
ORT_LICENSES="
    LICENSE                2f07c72751aed99790b8a4869cf2311df85a860b22ded05fa22803587a48922c
    ThirdPartyNotices.txt  0e07b95f3a8d6230037707c5c4a2b554d12c4cb67369669ac255635528ffcee2
"

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
DEST="$ROOT/.native"
OUT="$DEST/$NAME"
# Anything that changes what gets built changes this, so a stale build is
# never reused.
CMAKE_FLAGS=(
    -DCMAKE_BUILD_TYPE=Release
    -DBUILD_SHARED_LIBS=OFF
    -DSHERPA_ONNX_ENABLE_TTS=OFF
    -DSHERPA_ONNX_ENABLE_PORTAUDIO=OFF
    -DSHERPA_ONNX_ENABLE_WEBSOCKET=OFF
    -DSHERPA_ONNX_ENABLE_BINARY=OFF
    -DSHERPA_ONNX_BUILD_C_API_EXAMPLES=OFF
    -DSHERPA_ONNX_ENABLE_PYTHON=OFF
    -DSHERPA_ONNX_ENABLE_TESTS=OFF
    -DSHERPA_ONNX_ENABLE_C_API=ON
    # The precompiled static ONNX Runtime sherpa downloads was built on
    # manylinux2014, whose toolchain uses libstdc++'s pre-C++11 string ABI.
    # Upstream builds sherpa there too. Built here with the new ABI, the
    # two disagree and the first model load dies in free() (findings §9b).
    -DCMAKE_CXX_FLAGS=-D_GLIBCXX_USE_CXX11_ABI=0
)
# "licenses": builds before phase 8 kept no licence files (§8.3).
STAMP="$SRC_SHA256 ${CMAKE_FLAGS[*]} licenses-2"

if [[ "$(uname -m)" != "x86_64" ]]; then
    echo "only linux x86_64 is wired up so far ($(uname -m))" >&2
    exit 1
fi
for tool in curl sha256sum cmake make c++ ar; do
    command -v "$tool" >/dev/null || { echo "$tool is required" >&2; exit 1; }
done

if [[ -f "$OUT/.built" && "$(cat "$OUT/.built")" == "$STAMP" ]]; then
    echo "$NAME already built → $OUT"
    exit 0
fi

mkdir -p "$DEST"
work="$DEST/.build-$NAME"
rm -rf "$work" && mkdir -p "$work"
echo "fetching sherpa-onnx $VERSION source"
curl --fail --location --retry 3 --progress-bar -o "$work/src.tar.gz" "$SRC_URL"
if ! echo "$SRC_SHA256  $work/src.tar.gz" | sha256sum --check --status; then
    echo "checksum mismatch for the sherpa-onnx source — refusing to build it" >&2
    exit 1
fi
tar -xzf "$work/src.tar.gz" -C "$work"

echo "building (TTS off: no eSpeak NG in the result)"
cmake -S "$work/sherpa-onnx-$VERSION" -B "$work/build" \
    "${CMAKE_FLAGS[@]}" -DCMAKE_INSTALL_PREFIX="$work/install" >"$work/cmake.log" 2>&1
cmake --build "$work/build" -j "$(nproc)" >"$work/build.log" \
    || { echo "build failed; see $work/build.log" >&2; exit 1; }
cmake --install "$work/build" >/dev/null

# sherpa-onnx-sys (the Rust crate) links a fixed list of static libraries,
# TTS's among them. Empty archives stand in for those: nothing is taken from
# them, since TTS code is not compiled, and the check below proves it.
for lib in espeak-ng piper_phonemize ucd; do
    rm -f "$work/install/lib/lib$lib.a"
    ar rc "$work/install/lib/lib$lib.a"
done
for lib in espeak-ng piper_phonemize ucd; do
    [[ -z "$(ar t "$work/install/lib/lib$lib.a")" ]] \
        || { echo "lib$lib.a is not empty — refusing to install" >&2; exit 1; }
done

# The licence files of everything linked, for the packages' notices
# (phase-8 §8.3): sherpa-onnx's own, then each dependency cmake fetched,
# ONNX Runtime's prebuilt archive included.
lic="$work/install/licenses"
mkdir -p "$lic/sherpa-onnx"
cp "$work/sherpa-onnx-$VERSION/LICENSE" "$lic/sherpa-onnx/"
mkdir -p "$lic/onnxruntime"
while read -r f sha; do
    [[ -n "$f" ]] || continue
    curl --fail --location --retry 3 --silent -o "$lic/onnxruntime/$f" \
        "https://raw.githubusercontent.com/microsoft/onnxruntime/$ORT_TAG/$f"
    echo "$sha  $lic/onnxruntime/$f" | sha256sum --check --status \
        || { echo "checksum mismatch for ONNX Runtime's $f" >&2; exit 1; }
done <<<"$ORT_LICENSES"
for dep in "$work/build/_deps/"*-src; do
    [[ -d "$dep" ]] || continue
    name="$(basename "$dep" -src)"
    [[ "$name" == onnxruntime ]] && continue # the prebuilt binary: above
    files="$(find "$dep" -maxdepth 1 -type f \( -iname 'LICENSE*' -o -iname 'COPYING*' \
        -o -iname 'NOTICE*' -o -iname 'ThirdPartyNotices*' -o -iname 'COPYRIGHT*' \))"
    [[ -n "$files" ]] || { echo "warning: no licence file found in $name" >&2; continue; }
    mkdir -p "$lic/$name"
    while read -r f; do cp "$f" "$lic/$name/"; done <<<"$files"
done

rm -rf "$OUT"
mkdir -p "$OUT"
mv "$work/install/lib" "$work/install/include" "$lic" "$OUT/"
echo "$STAMP" >"$OUT/.built"
rm -rf "$work"
# Cargo relinks when a library *path* changes, not when the archive at the
# same path does: without this, binaries keep the previous build's code.
if command -v cargo >/dev/null; then
    (cd "$ROOT" && cargo clean -q -p sherpa-onnx-sys -p ort-sys &&
        cargo clean -q --release -p sherpa-onnx-sys -p ort-sys) || true
fi
echo "$NAME → $OUT"
