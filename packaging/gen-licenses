#!/usr/bin/env bash
# The licence texts and notices of everything linked into the binaries
# (phase-8 §8.3, THIRD_PARTY.md "Before anything is packaged"), generated
# from the dependency graph rather than by hand.
#
#   packaging/gen-licenses [OUT_DIR]     # default: packaging/out/licenses
#
# Writes:
#   cosmo.txt         cosmod (with `ears`), cosmo, cosmo-overlay: their
#                     crates' licences, then the native libraries' (from
#                     scripts/fetch-native). GPL is not accepted for these:
#                     a GPL crate reaching them fails the run.
#   cosmo-applet.txt  cosmo-applet's crates, where GPL-3.0-only is accepted
#                     (the two cosmic-panel crates every applet links).
#
# Needs cargo-about (`cargo install --locked cargo-about --features cli`).
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
OUT="${1:-$ROOT/packaging/out/licenses}"
NATIVE="$ROOT/.native/sherpa-onnx-v1.13.8-asr-static/licenses"
ABOUT="$(command -v cargo-about || echo "$HOME/.cargo/bin/cargo-about")"
[[ -x "$ABOUT" ]] || { echo "cargo-about is required (see the header)" >&2; exit 1; }
[[ -d "$NATIVE" ]] || { echo "no native licences: re-run scripts/fetch-native" >&2; exit 1; }

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT
mkdir -p "$OUT"

# about <config> <crate> [features] → $work/<crate>.json
about() {
    local cfg="$1" crate="$2" features="${3:-}"
    "$ABOUT" generate --format json --locked --fail -c "$cfg" \
        -m "$ROOT/crates/$crate/Cargo.toml" ${features:+--features "$features"} \
        -o "$work/$crate.json" 2>"$work/$crate.log" \
        || { cat "$work/$crate.log" >&2; echo "$crate: licence check failed (above)" >&2; exit 1; }
}

about "$ROOT/packaging/about.toml" cosmo-daemon ears
about "$ROOT/packaging/about.toml" cosmo-cli
about "$ROOT/packaging/about.toml" cosmo-overlay
# The applet alone may link GPL-3.0-only crates (THIRD_PARTY.md).
sed 's/^accepted = \[/accepted = [\n    "GPL-3.0-only",/' "$ROOT/packaging/about.toml" >"$work/about-applet.toml"
about "$work/about-applet.toml" cosmo-applet

python3 - "$work" "$OUT" "$NATIVE" <<'PY'
import json, os, sys
work, out, native = sys.argv[1:]

def merge(names):
    """Licence text -> (id, sorted 'crate version' users), deduplicated."""
    seen = {}
    for n in names:
        for lic in json.load(open(os.path.join(work, n + ".json")))["licenses"]:
            users = {f'{u["crate"]["name"]} {u["crate"]["version"]}' for u in lic["used_by"]}
            users = {u for u in users if not u.startswith("cosmo-")}
            if not users:
                continue
            key = lic["text"].strip()
            seen.setdefault(key, (lic["id"], set()))[1].update(users)
    return sorted(seen.items(), key=lambda kv: (kv[1][0], sorted(kv[1][1])))

def write(path, title, entries, extra=""):
    rule = "=" * 78
    with open(path, "w") as f:
        f.write(f"{title}\n\nGenerated by packaging/gen-licenses from Cargo.lock.\n\n")
        for text, (lid, users) in entries:
            f.write(f"{rule}\n{lid}, used by: {', '.join(sorted(users))}\n{rule}\n\n{text}\n\n")
        f.write(extra)

native_text = ""
for lib in sorted(os.listdir(native)):
    for fn in sorted(os.listdir(os.path.join(native, lib))):
        body = open(os.path.join(native, lib, fn), errors="replace").read().strip()
        native_text += f'{"=" * 78}\nnative library {lib}: {fn}\n{"=" * 78}\n\n{body}\n\n'

write(os.path.join(out, "cosmo.txt"),
      "Third-party licences: cosmod, cosmo, cosmo-overlay",
      merge(["cosmo-daemon", "cosmo-cli", "cosmo-overlay"]), native_text)
write(os.path.join(out, "cosmo-applet.txt"),
      "Third-party licences: cosmo-applet (as distributed, GPL-3.0-only)",
      merge(["cosmo-applet"]))
PY
echo "licences → $OUT"
