#!/usr/bin/env bash
# Build cosmo's .deb packages for Pop!_OS / Ubuntu (phase-8 §8.3).
#
#   packaging/build-deb              # release build, then package
#   packaging/build-deb --no-build   # package what target/release has
#
# Writes to packaging/out/:
#   cosmo_<ver>_amd64.deb         cosmod, cosmo, cosmo-overlay, the user unit
#                                 (enabled for every user), the overlay's
#                                 autostart, the model fetcher. MIT, plus the
#                                 permissive licences of what it links.
#   cosmo-applet_<ver>_amd64.deb  the panel applet: GPL-3.0 as distributed
#                                 (it links two GPL cosmic-panel crates; its
#                                 own source stays MIT). THIRD_PARTY.md.
#
# Models are never packaged: `cosmo models fetch` gets them per user.
# Needs: dpkg-dev, cargo-about, and scripts/fetch-native run once.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
PKG="$ROOT/packaging"
OUT="$PKG/out"
REL="$ROOT/target/release"
VERSION="$(sed -n 's/^version = "\(.*\)"/\1/p' "$ROOT/Cargo.toml" | head -1)"
DEB_VERSION="${VERSION}-1"
ARCH="$(dpkg --print-architecture)"
COMMIT="$(git -C "$ROOT" rev-parse HEAD 2>/dev/null || echo unknown)"
REPO="https://github.com/speerdo/cosmic-ai-assistant"
MAINTAINER="$(git -C "$ROOT" config user.name 2>/dev/null || echo cosmo) <$(git -C "$ROOT" config user.email 2>/dev/null || echo root@localhost)>"

build=1
case "${1:-}" in
    --no-build) build=0 ;;
    "") ;;
    -h|--help) sed -n '2,18p' "$0"; exit 0 ;;
    *) echo "unknown argument: $1" >&2; exit 2 ;;
esac
for tool in dpkg-deb dpkg-shlibdeps; do
    command -v "$tool" >/dev/null || { echo "$tool is required (apt install dpkg-dev)" >&2; exit 1; }
done

if (( build )); then
    [[ -d "$ROOT/.native" ]] || { echo "run scripts/fetch-native first" >&2; exit 1; }
    (cd "$ROOT" && cargo build --release --locked -p cosmo-daemon --features ears --bin cosmod \
        && cargo build --release --locked -p cosmo-cli -p cosmo-overlay -p cosmo-applet)
fi
"$PKG/check-deps" "$REL"
"$PKG/gen-licenses" "$OUT/licenses"

# shlibs <binary>…: versioned Depends for what the binaries link.
shlibs() {
    local tmp
    tmp="$(mktemp -d)"
    mkdir -p "$tmp/debian"
    printf 'Source: cosmo\n\nPackage: cosmo\nArchitecture: any\n' >"$tmp/debian/control"
    (cd "$tmp" && dpkg-shlibdeps -O "${@/#/-e}" 2>/dev/null) | sed -n 's/^shlibs:Depends=//p'
    rm -rf "$tmp"
}

# stage <name>: a clean staging root for one package.
stage() {
    local dir="$OUT/stage/$1"
    rm -rf "$dir"
    mkdir -p "$dir/DEBIAN"
    echo "$dir"
}

# ---- cosmo ------------------------------------------------------------
S="$(stage cosmo)"
install -Dm0755 -t "$S/usr/bin" "$REL/cosmod" "$REL/cosmo" "$REL/cosmo-overlay"
install -Dm0755 "$ROOT/scripts/fetch-models" "$S/usr/libexec/cosmo/fetch-models"
install -Dm0644 "$PKG/systemd/cosmo.service" "$S/usr/lib/systemd/user/cosmo.service"
install -Dm0644 "$PKG/desktop/io.github.speerdo.CosmoOverlay.desktop" \
    "$S/etc/xdg/autostart/io.github.speerdo.CosmoOverlay.desktop"
DOC="$S/usr/share/doc/cosmo"
install -Dm0644 -t "$DOC" "$ROOT/README.md" "$ROOT/THIRD_PARTY.md"
install -Dm0644 "$OUT/licenses/cosmo.txt" "$DOC/third-party-licenses.txt"
cat >"$DOC/copyright" <<EOF
Format: https://www.debian.org/doc/packaging-manuals/copyright-format/1.0/
Upstream-Name: cosmo
Source: $REPO/tree/$COMMIT

Files: *
Copyright: cosmo contributors
License: MIT
$(sed 's/^$/./; s/^/ /' "$ROOT/LICENSE")

Comment:
 cosmod, cosmo and cosmo-overlay statically link Rust crates and native
 libraries (sherpa-onnx, ONNX Runtime and their dependencies) under
 permissive licences: MIT, Apache-2.0, BSD, ISC, Zlib, MPL-2.0 (libcosmic,
 Eigen headers), OFL-1.1 (two fonts libcosmic embeds) and others. Each
 licence text, with the components that use it, is in
 /usr/share/doc/cosmo/third-party-licenses.txt. No GPL code is linked;
 eSpeak NG (GPL-3.0) is the system's libespeak-ng, loaded at run time.
 Speech models are downloaded by the user (cosmo models fetch), each with
 its own terms (THIRD_PARTY.md); none is in this package.
EOF

cat >"$S/DEBIAN/control" <<EOF
Package: cosmo
Version: $DEB_VERSION
Architecture: $ARCH
Maintainer: $MAINTAINER
Depends: $(shlibs "$S/usr/bin/cosmod" "$S/usr/bin/cosmo" "$S/usr/bin/cosmo-overlay"), libespeak-ng1, tmux, curl, bzip2, tar
Recommends: cosmo-applet
Suggests: npm
Section: utils
Priority: optional
Homepage: $REPO
Description: voice front-end for MCP on the COSMIC desktop
 cosmo gives a hard-gated microphone to MCP servers on your Linux desktop,
 speaks in a voice you chose, and knows how to drive COSMIC. Hold Right Ctrl
 and talk: speech recognition and the voice are local; only the reasoning
 model is in the cloud, with the provider of your choice.
 .
 After installing, run "cosmo models fetch" once (about 1.6 GB of local
 models), then "cosmo doctor". Desktop control needs computer-use-linux:
 npm install -g @agent-sh/computer-use-linux
EOF
# The daemon runs per user, in the graphical session. Enabled for every
# user, as a user unit; each user's session starts it at the next login.
cat >"$S/DEBIAN/postinst" <<'EOF'
#!/bin/sh
set -e
if [ "$1" = configure ] && command -v systemctl >/dev/null; then
    systemctl --global enable cosmo.service >/dev/null 2>&1 || true
fi
EOF
cat >"$S/DEBIAN/prerm" <<'EOF'
#!/bin/sh
set -e
if [ "$1" = remove ] && command -v systemctl >/dev/null; then
    systemctl --global disable cosmo.service >/dev/null 2>&1 || true
fi
EOF
chmod 0755 "$S/DEBIAN/postinst" "$S/DEBIAN/prerm"
dpkg-deb --root-owner-group -Zxz --build "$S" "$OUT/cosmo_${DEB_VERSION}_${ARCH}.deb"

# ---- cosmo-applet -----------------------------------------------------
S="$(stage cosmo-applet)"
install -Dm0755 -t "$S/usr/bin" "$REL/cosmo-applet"
install -Dm0644 "$PKG/desktop/io.github.speerdo.CosmoApplet.desktop" \
    "$S/usr/share/applications/io.github.speerdo.CosmoApplet.desktop"
DOC="$S/usr/share/doc/cosmo-applet"
install -Dm0644 "$OUT/licenses/cosmo-applet.txt" "$DOC/third-party-licenses.txt"
cat >"$DOC/copyright" <<EOF
Format: https://www.debian.org/doc/packaging-manuals/copyright-format/1.0/
Upstream-Name: cosmo-applet
Source: $REPO/tree/$COMMIT

Files: *
Copyright: cosmo contributors
License: GPL-3.0-only
 The cosmo-applet binary links cosmic-panel-config and
 xdg-shell-wrapper-config (GPL-3.0-only), as every COSMIC panel applet
 does, so this binary is distributed under the GNU General Public License,
 version 3. Its own source code is MIT, which is GPL-compatible. The
 complete corresponding source is at the Source URL above (this commit,
 with Cargo.lock pinning every dependency).
 .
 On Debian systems the full GPL-3 text is in
 /usr/share/common-licenses/GPL-3. Every other component's licence is in
 /usr/share/doc/cosmo-applet/third-party-licenses.txt.
EOF
cat >"$S/DEBIAN/control" <<EOF
Package: cosmo-applet
Version: $DEB_VERSION
Architecture: $ARCH
Maintainer: $MAINTAINER
Depends: $(shlibs "$S/usr/bin/cosmo-applet"), cosmo (= $DEB_VERSION)
Section: utils
Priority: optional
Homepage: $REPO
Description: COSMIC panel applet for cosmo
 Shows cosmo's state in the COSMIC panel, with a popup for its voice,
 listening and readiness. Add it in Settings → Desktop → Panel → Applets.
 A thin client of the cosmo daemon, which owns everything.
EOF
dpkg-deb --root-owner-group -Zxz --build "$S" "$OUT/cosmo-applet_${DEB_VERSION}_${ARCH}.deb"

rm -rf "$OUT/stage"
ls -la "$OUT"/*.deb
